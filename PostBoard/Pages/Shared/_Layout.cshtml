<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PostBoard</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark border-bottom">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">PostBoard</a>
            <div class="navbar-nav ms-auto d-flex align-items-center flex-row gap-3">
                <div>
                    <a class="nav-link" asp-page="/Index">Browse</a>
                </div>
                <div>
                    <a class="btn btn-light btn-sm px-3" asp-page="/Create">New post</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        @RenderBody()
    </main>

    <footer class="container pb-4 text-secondary small">
        Demo data from <a href="https://jsonplaceholder.typicode.com/" target="_blank" rel="noopener">JSONPlaceholder</a>.
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
